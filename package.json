    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.0.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.0.0",
    "pg": "^8.23.0",
